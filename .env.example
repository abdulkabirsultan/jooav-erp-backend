# Database Configuration
# Development (Local PostgreSQL)
DIRECT_URL="postgresql://jooav:password@localhost:5432/jooav_erp_dev"
DATABASE_URL="postgresql://jooav:password@localhost:5432/jooav_erp_dev"
DATABASE_SCHEMA="public"

# Application
NODE_ENV=development
PORT=3001
API_VERSION=v1
API_PREFIX=api

# Security
JWT_SECRET=a-super-super-super-secure
JWT_EXPIRES_IN=1d

# Sentry Error Tracking
SENTRY_DSN=

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Swagger
SWAGGER_TITLE="JOOAV ERP API"
SWAGGER_DESCRIPTION="Enterprise Resource Planning System API"
SWAGGER_VERSION="1.0"
SWAGGER_TAG="api"

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_FILENAME=logs/app.log
LOG_ERROR_FILENAME=logs/error.log
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14
LOG_DATE_PATTERN=YYYY-MM-DD

# Health Check
HEALTH_CHECK_TIMEOUT=1000
HEALTH_CHECK_GRACE_PERIOD=3000

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true


# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CLOUDINARY_FOLDER=jooav-erp
CLOUDINARY_MAX_FILE_SIZE=10485760
CLOUDINARY_ALLOWED_FORMATS=jpg,jpeg,png,gif,webp,pdf,doc,docx,xls,xlsx

# Redis Configuration
Development (Local Redis)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=mypassword
REDIS_TLS=true

# Production (Upstash Redis) - Currently configured
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Redis Cloud for Bull Queue (free tier - unlimited commands)
REDIS_CLOUD_HOST=
REDIS_CLOUD_PORT=
REDIS_CLOUD_USERNAME=
REDIS_CLOUD_PASSWORD=

# Redis Connection Settings
REDIS_RETRY_ATTEMPTS=3
REDIS_RETRY_DELAY=1000

# Email Configuration (Resend)
EMAIL_ENABLED=true
RESEND_API_KEY=

EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME="JOOAV ERP System"
APP_BASE_URL=http://localhost:3000

# Monnify Configuration
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
